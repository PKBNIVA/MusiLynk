# Vercel frontend
VITE_API_URL=https://musilynk-api-production.up.railway.app/api
VITE_PUBLIC_URL=https://musilynk.vercel.app
# Optional. Set to /api on the public Vercel project so the landing page's anonymous reads use the
# same-origin path that Vercel rewrites to the API and caches at the edge (docs/ops/edge-caching.md).
# Unset, those reads go to VITE_API_URL like every other call.
VITE_PUBLIC_API_BASE=

# Rails API on Railway
RAILS_ENV=production
SECRET_KEY_BASE=generate-with-openssl-rand-hex-64
DATABASE_URL=provided-by-railway-postgresql
FRONTEND_URL=https://musilynk.vercel.app
FRONTEND_HOST=musilynk.vercel.app
ALLOWED_ORIGINS=https://musilynk.vercel.app
API_HOST=https://musilynk-api-production.up.railway.app
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-unique-password-of-at-least-14-characters
SEED_DEMO_DATA=false

# S3-compatible object storage (Cloudflare R2, AWS S3, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT_URL_S3=
# Required whenever AWS_ENDPOINT_URL_S3 is set (R2): the https r2.dev or custom-domain origin.
AWS_PUBLIC_BASE_URL=
# Optional: post | put. Defaults to put for *.r2.cloudflarestorage.com, post otherwise.
AWS_UPLOAD_METHOD=
# Optional: an R2 public or custom domain that fronts the bucket for reads (docs/ops/uploads.md).
# Public upload URLs use it instead of AWS_PUBLIC_BASE_URL; unset, nothing changes.
UPLOADS_PUBLIC_BASE_URL=

# Durable jobs use the Railway PostgreSQL database.
GOOD_JOB_EXECUTION_MODE=async
GOOD_JOB_MAX_THREADS=2
GOOD_JOB_POLL_INTERVAL=10
GOOD_JOB_ENABLE_CRON=true
# Separate worker service only (see DEPLOYMENT.md, "Separate job worker").
# WORKER_MIGRATION_WAIT_SECONDS=600
# GOOD_JOB_SHUTDOWN_TIMEOUT=25

# Set to true once Railway's pre-deploy step runs migrations (DEPLOYMENT.md).
SKIP_DB_PREPARE_ON_BOOT=false
# Postgres per-connection limits (defaults shown; 0 = no limit).
# DB_STATEMENT_TIMEOUT=15s
# DB_LOCK_TIMEOUT=5s
# WORKER_DB_STATEMENT_TIMEOUT=5min
# WORKER_DB_LOCK_TIMEOUT=30s

# Transactional email. Prefer one configured provider.
EMAIL_DELIVERY_WEBHOOK=
EMAIL_DELIVERY_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=MusiLynk <notifications@your-domain.com>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=admin@notify.alienbrains.in
BREVO_SENDER_NAME=MusiLynk
# Shared secret for POST /api/email/webhook/brevo (bounces, complaints). Unset = endpoint refuses all calls.
BREVO_WEBHOOK_SECRET=

# Sign-in. Email codes (POST /api/auth/otp/*) are always on. Keep password login
# enabled until production email delivery (inbox receipt) is verified; setting
# "false" makes /api/auth/login return 403 PASSWORD_LOGIN_DISABLED.
PASSWORD_LOGIN_ENABLED=true

# AI writing help. Provider is chosen by config (backend/config/ai_pricing.yml, default openai);
# AI_PROVIDER overrides it (openai|anthropic). AI is reported disabled (deterministic fallbacks
# everywhere) unless the selected provider's key is set. Never commit real values.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional model override; the default lives in ai_pricing.yml (gpt-5.6-luna).
OPENAI_MODEL=
# Only needed when AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=

# Razorpay. Leave blank until live checkout and webhooks are ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_STUDIO=

# Temporary gate for reversible synthetic QA only.
ALLOW_SYNTHETIC_QA=false
SYNTHETIC_QA_PASSWORD=

# Error tracking (Sentry). Blank = disabled; see DEPLOYMENT.md "Error alerting and uptime".
# API (Railway):
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Web (Vercel, read at build time):
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
